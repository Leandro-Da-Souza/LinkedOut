# Generation requires a user-supplied OpenAI API key. Do not commit real keys.
OPENAI_API_KEY=
# Must support Responses, strict function calling, and structured outputs.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Optional. Defaults to .linkedout relative to the process working directory.
# Use absolute paths when launching from an MCP client.
# LINKEDOUT_DATA_DIR=/absolute/path/to/linkedout/.linkedout

# Optional JSON profile; omit for the default local professional profile.
# LINKEDOUT_PROFILE_PATH=/absolute/path/to/linkedout/user.json

# Optional private reference directory (PDF, Markdown, UTF-8 text).
# Keep it named knowledge/ so the repository's ignore rules cover all contents.
# Defaults to ./knowledge. Only relevant excerpts are sent in drafting requests.
# LINKEDOUT_KNOWLEDGE_DIR=/absolute/path/to/linkedout/knowledge

# Optional overall workflow deadline in milliseconds; default is 120000.
# LINKEDOUT_RUN_TIMEOUT_MS=120000
